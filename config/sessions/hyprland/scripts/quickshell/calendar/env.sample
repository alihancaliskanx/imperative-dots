# Copy to .env in this directory if you want somewhere other than Istanbul.
#
# Open-Meteo needs no API key and no account — only a coordinate. Find yours at
# https://www.latlong.net or by right-clicking a spot in Google Maps.
#
#   WEATHER_LAT / WEATHER_LON   decimal degrees. Defaults: Istanbul.
#                               Ankara  39.9334  32.8597
#                               Izmir   38.4237  27.1428
#   WEATHER_UNIT                metric | imperial
#
# Without this file the defaults below apply, so the weather works out of the box.

WEATHER_LAT=41.0138
WEATHER_LON=28.9497
WEATHER_UNIT=metric
