# kdeglobals — the palette Qt apps read outside Plasma.
#
# dolphin is a KF6 application, and KF6 takes its colours from here rather than
# from whatever platform theme is loaded. qt6ct themes its own window happily
# and leaves dolphin untouched; KDE_COLOR_SCHEME_PATH is ignored as well. This
# file is the only thing that moves it, so this is where matugen has to write.
#
# The roles map the same way the qt5ct/qt6ct palette does, so the two agree:
# Window is surface, the view is the lowest container, buttons the high one,
# and the selection is primary with on_primary sitting on top of it.
#
# KConfig parses "#rrggbb" as well as its own "r,g,b", so the hex matugen
# already emits goes in unchanged.

[ColorEffects:Disabled]
ChangeSelectionColor=
Color={{colors.surface_container.default.hex}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
Enable=
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.outline.default.hex}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

