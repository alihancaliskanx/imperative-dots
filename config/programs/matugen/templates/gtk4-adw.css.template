/* libadwaita colours for GTK4, as CSS custom properties.
 *
 * The sibling gtk.css.template writes the same palette as @define-color. That is
 * what libadwaita read up to 1.5; from 1.6 on it takes its colours from these
 * variables instead and ignores the @define-color names, so on libadwaita 1.9
 * a themed gtk.css left every app sitting on stock #1d1d20. Both files are
 * generated because GTK3 still wants the old spelling.
 *
 * :root rather than a selector — libadwaita resolves these once at the top and
 * every widget inherits from there. */

:root {
    --window-bg-color: {{colors.surface.default.hex}};
    --window-fg-color: {{colors.on_surface.default.hex}};

    --view-bg-color: {{colors.surface_container_lowest.default.hex}};
    --view-fg-color: {{colors.on_surface.default.hex}};

    --sidebar-bg-color: {{colors.surface_container_low.default.hex}};
    --sidebar-fg-color: {{colors.on_surface_variant.default.hex}};
    --sidebar-backdrop-color: {{colors.surface_container_low.default.hex}};
    --sidebar-border-color: {{colors.outline_variant.default.hex}};
    --secondary-sidebar-bg-color: {{colors.surface_container.default.hex}};
    --secondary-sidebar-fg-color: {{colors.on_surface_variant.default.hex}};

    --headerbar-bg-color: {{colors.surface_container.default.hex}};
    --headerbar-fg-color: {{colors.on_surface.default.hex}};
    --headerbar-border-color: {{colors.outline_variant.default.hex}};
    --headerbar-backdrop-color: {{colors.surface.default.hex}};

    --popover-bg-color: {{colors.surface_container_high.default.hex}};
    --popover-fg-color: {{colors.on_surface.default.hex}};
    --dialog-bg-color: {{colors.surface_container_high.default.hex}};
    --dialog-fg-color: {{colors.on_surface.default.hex}};

    --card-bg-color: {{colors.surface_container_highest.default.hex}};
    --card-fg-color: {{colors.on_surface.default.hex}};

    --accent-color: {{colors.primary.default.hex}};
    --accent-bg-color: {{colors.primary.default.hex}};
    --accent-fg-color: {{colors.on_primary.default.hex}};

    --destructive-color: {{colors.error.default.hex}};
    --destructive-bg-color: {{colors.error.default.hex}};
    --destructive-fg-color: {{colors.on_error.default.hex}};

    --success-color: {{colors.tertiary.default.hex}};
    --success-bg-color: {{colors.tertiary.default.hex}};
    --success-fg-color: {{colors.on_tertiary.default.hex}};

    --warning-color: {{colors.secondary.default.hex}};
    --warning-bg-color: {{colors.secondary.default.hex}};
    --warning-fg-color: {{colors.on_secondary.default.hex}};

    --error-color: {{colors.error.default.hex}};
    --error-bg-color: {{colors.error.default.hex}};
    --error-fg-color: {{colors.on_error.default.hex}};
}
